{
  "name": "axelrod-experiment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "阿克塞尔罗德重复囚徒困境锦标赛 · 可视化复现",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node test/browser-check.cjs",
    "test:e2e": "npm run build && node test/browser-check.cjs",
    "verify": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}

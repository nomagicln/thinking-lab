{
  "name": "thinking-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "一些关于人怎么想、怎么合作、怎么犯错的小实验",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node test/browser-check.cjs",
    "test:e2e": "npm run build && node test/browser-check.cjs",
    "verify": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
